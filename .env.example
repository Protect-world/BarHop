# ============================================
# BarHop 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# 服务配置
SERVER_PORT=3000
SERVER_BASE_URL=http://your-domain.com
NODE_ENV=production

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=barhop
MYSQL_USER=barhop_user
MYSQL_PASSWORD=your_db_password

# Redis 配置
REDIS_PASSWORD=your_redis_password

# JWT 配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters

# 微信小程序配置
WECHAT_APPID=wx_your_appid_here
WECHAT_SECRET=your_wechat_secret_here

# 高德地图配置
AMAP_KEY=your_amap_api_key_here
