.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #16213E 0%, #1A1A2E 100%);
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  padding: 40rpx 0;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background: transparent;
  border: none;
  position: relative;
  line-height: normal;
  border-radius: 50%;
  overflow: visible;
  cursor: pointer;
  margin: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn:active {
  opacity: 0.7;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #E94560;
  background: rgba(255, 255, 255, 0.1);
}

.avatar-edit {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 48rpx;
  height: 48rpx;
  background: #E94560;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(233, 69, 96, 0.5);
}

.edit-icon {
  font-size: 22rpx;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.form-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.form-item {
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  min-height: 96rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-left: 16rpx;
  min-height: 60rpx;
}

.placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.action-section {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 0 0;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #E94560 0%, #c73650 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(233, 69, 96, 0.3);
}

.btn-primary[disabled] {
  opacity: 0.6;
  transform: none;
}

.btn-secondary {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.8);
  font-size: 30rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.97);
}