.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #16213E 0%, #1A1A2E 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 50rpx 30rpx 60rpx;
  background: linear-gradient(135deg, #E94560 0%, #c73650 100%);
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.stats {
  display: flex;
  align-items: baseline;
  position: relative;
  z-index: 1;
}

.count {
  font-size: 68rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-list {
  padding: 30rpx;
}

.bar-card {
  display: flex;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease;
}

.bar-card:active {
  transform: scale(0.98);
}

.bar-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.bar-info {
  flex: 1;
  padding: 24rpx;
  padding-right: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.bar-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rating {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.star {
  color: #FFFFFF;
  font-size: 22rpx;
  margin-right: 6rpx;
}

.score {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.rating.no-rating {
  background: rgba(255, 255, 255, 0.15);
  box-shadow: none;
}

.rating.no-rating .score {
  font-size: 22rpx;
  font-weight: 400;
}

.bar-tags {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #FF6B8B;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.25), rgba(255, 107, 107, 0.15));
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.bar-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.heart-icon {
  width: 40rpx;
  height: 40rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-image-wrapper {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  position: relative;
  background: rgba(255, 255, 255, 0.05);
}

.bar-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.15), rgba(255, 107, 107, 0.1));
}

.placeholder-icon {
  font-size: 60rpx;
  opacity: 0.6;
}
