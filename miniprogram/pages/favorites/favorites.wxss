.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #16213E 0%, #1A1A2E 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 28rpx 30rpx 34rpx;
  background: linear-gradient(135deg, #E94560 0%, #c73650 100%);
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.stats {
  display: flex;
  align-items: baseline;
  position: relative;
  z-index: 1;
}

.count {
  font-size: 68rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-list {
  padding: 30rpx;
}

.bar-card {
  display: flex;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease;
}

.bar-card:active {
  transform: scale(0.98);
}

.bar-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.bar-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.bar-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.bar-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rating {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.star {
  color: #FFFFFF;
  font-size: 22rpx;
  margin-right: 6rpx;
}

.score {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.rating-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.rating.no-rating {
  background: rgba(255, 255, 255, 0.15);
  box-shadow: none;
}

.rating.no-rating .score {
  font-size: 22rpx;
  font-weight: 400;
}

.bar-tags {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #FF6B8B;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.25), rgba(255, 107, 107, 0.15));
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.bar-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.favorite-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(233, 69, 96, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(233, 69, 96, 0.3);
  padding: 0;
  box-sizing: border-box;
}

.heart-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
  vertical-align: middle;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: rgba(255, 255, 255, 0.5);
}

.list-bottom-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 2rpx;
}

.bar-image-wrapper {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  position: relative;
  background: rgba(255, 255, 255, 0.05);
}

.bar-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.15), rgba(255, 107, 107, 0.1));
}

.placeholder-icon {
  font-size: 60rpx;
  opacity: 0.6;
}

/* ============ 骨架屏 ============ */
.shimmer {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.04) 0%,
    rgba(255, 255, 255, 0.12) 50%,
    rgba(255, 255, 255, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.skeleton-list {
  padding: 30rpx;
}

.skeleton-card {
  display: flex;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.skeleton-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.skeleton-line {
  border-radius: 8rpx;
}
