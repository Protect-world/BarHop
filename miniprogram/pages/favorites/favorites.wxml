<view class="container">
  <view class="header">
    <view class="stats">
      <text class="count">{{total}}</text>
      <text class="label">家收藏的酒吧</text>
    </view>
  </view>

  <view wx:if="{{bars.length === 0}}" class="empty">
    <text class="empty-icon">🍺</text>
    <text class="empty-text">还没有收藏任何酒吧</text>
    <text class="empty-hint">快去发现附近的好酒吧吧</text>
  </view>

  <view wx:else class="bar-list">
    <view class="bar-card" wx:for="{{bars}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="bar-image-wrapper">
        <image 
          class="bar-image" 
          src="{{item.photos[0]}}"
          mode="aspectFill"
          binderror="onImageError"
          data-index="{{index}}"
        />
      </view>
      <view class="bar-info">
        <view class="bar-header">
          <text class="bar-name">{{item.name}}</text>
          <view class="rating" wx:if="{{item.has_rating}}">
            <text class="star">★</text>
            <text class="score">{{item.avg_rating}}</text>
          </view>
          <view class="rating no-rating" wx:else>
            <text class="score">暂无</text>
          </view>
        </view>
        <view class="bar-tags">
          <text class="tag">{{item.tags}}</text>
        </view>
        <view class="bar-address">{{item.address}}</view>
      </view>
      <view class="favorite-btn" catchtap="toggleFavorite" data-id="{{item.id}}">
        <image class="heart-icon" src="/images/favorite_active.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
