<view class="container">
  <network-banner />
  <view class="header">
    <view class="stats">
      <text class="count">{{total}}</text>
      <text class="label">家收藏的酒吧</text>
    </view>
  </view>

  <!-- 骨架屏：加载中 -->
  <view class="bar-list" wx:if="{{loading && bars.length === 0}}">
    <view class="skeleton-list">
      <view class="skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="skeleton-img shimmer"></view>
        <view class="skeleton-info">
          <view class="skeleton-line shimmer" style="width: 60%; height: 32rpx"></view>
          <view class="skeleton-line shimmer" style="width: 80%; height: 24rpx"></view>
          <view class="skeleton-line shimmer" style="width: 40%; height: 24rpx"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{bars.length === 0}}" class="empty">
    <text class="empty-icon">🍺</text>
    <text class="empty-text">还没有收藏任何酒吧</text>
    <text class="empty-hint">快去发现附近的好酒吧吧</text>
  </view>

  <view wx:else class="bar-list">
    <view class="bar-card" wx:for="{{bars}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="bar-image-wrapper">
        <image 
          class="bar-image" 
          src="{{item.photos[0]}}"
          mode="aspectFill"
          binderror="onImageError"
          data-index="{{index}}"
        />
      </view>
      <view class="bar-info">
        <view class="bar-header">
          <text class="bar-name">{{item.name}}</text>
          <view class="rating" wx:if="{{item.has_rating}}">
            <text class="star">★</text>
            <text class="score">{{item.avg_rating}}</text>
            <text class="rating-tag" wx:if="{{item.rating_source === 'user'}}">用户</text>
          </view>
          <view class="rating no-rating" wx:else>
            <text class="score">暂无</text>
          </view>
        </view>
        <view class="bar-tags">
          <text class="tag">{{item.tags}}</text>
        </view>
        <view class="bar-bottom">
          <text class="bar-address">{{item.address}}</text>
          <view class="favorite-btn" catchtap="toggleFavorite" data-id="{{item.id}}">
            <image class="heart-icon" src="/images/favorite_active.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="list-bottom-tip" wx:if="{{!loading && bars.length > 0}}">— 已经收藏完啦~ —</view>
</view>
