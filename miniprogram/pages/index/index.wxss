.page-container {
  width: 100%;
  height: 100vh;
  background-color: #16213E;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fixed-header {
  flex-shrink: 0;
  background-color: #16213E;
}

.list-scroll {
  flex: 1;
  height: 0;
}

.age-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.age-modal-content {
  width: 80%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #1A1A2E, #16213E);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.age-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.age-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.age-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 10rpx;
}

.age-warning {
  font-size: 24rpx;
  color: #E94560;
  margin-bottom: 40rpx;
}

.age-buttons {
  display: flex;
  gap: 24rpx;
}

.age-buttons .btn-secondary,
.age-buttons .btn-primary {
  flex: 1;
}

.user-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx 16rpx;
  position: relative;
  z-index: 10;
}

.user-avatar-btn {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  overflow: visible;
}

.user-avatar-btn::after {
  border: none;
}

.user-avatar-btn:active {
  opacity: 0.7;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 69, 96, 0.6);
  background: rgba(255, 255, 255, 0.1);
}

.user-info {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  flex: 1;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: transparent;
  padding: 0;
  height: auto;
  line-height: 1.3;
}

.user-nickname-placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 32rpx;
  font-weight: 600;
}

.user-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-edit {
  font-size: 28rpx;
  padding: 16rpx;
  margin-left: auto;
}

.user-bar-loading .user-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(255,255,255,0.1) 25%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0.1) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.user-bar-loading .user-nickname-placeholder {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  animation: pulse 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.7; }
}

.search-bar {
  position: relative;
  padding: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
  border-radius: 44rpx;
  padding: 0 30rpx;
  height: 88rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.search-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  height: 100%;
  background: transparent;
  border: none;
  color: #FFFFFF;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 10rpx;
}

.search-history-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  background: #1A1A2E;
  border-radius: 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  z-index: 100;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.history-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.history-clear {
  font-size: 26rpx;
  color: #E94560;
}

.history-list {
  max-height: 400rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-icon {
  font-size: 28rpx;
  opacity: 0.6;
}

.history-keyword {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.history-item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.history-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.history-delete {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 8rpx;
}

.history-delete:active {
  color: #E94560;
}

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.history-empty-icon {
  font-size: 60rpx;
  opacity: 0.5;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.category-filter {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
  border-radius: 36rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.filter-item.active {
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(233, 69, 96, 0.4);
  transform: scale(1.05);
}

.map-container {
  position: relative;
  width: 100%;
  height: 500rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.location-icon {
  font-size: 36rpx;
}

.choose-location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 130rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(26, 26, 46, 0.9);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.choose-location-icon {
  font-size: 28rpx;
}

.choose-location-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.list-container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.list-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.list-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sort-icon {
  font-size: 24rpx;
  color: #E94560;
}

.sort-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.list-bottom-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  padding: 40rpx 0 20rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s ease;
}

.bar-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.bar-card-active {
  border-color: #E94560 !important;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.2), rgba(233, 69, 96, 0.05)) !important;
  box-shadow: 0 8rpx 32rpx rgba(233, 69, 96, 0.3) !important;
  transform: scale(1.02);
}

.bar-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.bar-info {
  flex: 1;
  min-width: 0;
}

.bar-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.bar-tag {
  font-size: 22rpx;
  color: #FF6B8B;
  background: linear-gradient(135deg, rgba(233, 69, 96, 0.25), rgba(255, 107, 107, 0.15));
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.bar-rating {
  font-size: 24rpx;
  color: #FFD700;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.bar-rating-none {
  color: rgba(255, 255, 255, 0.3);
  font-weight: 400;
}

.bar-distance {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.bar-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.2);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #E94560;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}