.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #16213E 0%, #1A1A2E 100%);
  padding: 30rpx;
}

.bar-info {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.bar-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.bar-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
}

.section-title {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
  font-weight: 600;
}

.rating-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.rating-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.rating-stars .star {
  margin: 0 12rpx;
}

.star {
  font-size: 88rpx;
  color: rgba(255, 255, 255, 0.25);
  transition: all 0.3s ease;
}

.star.active {
  color: #FFD700;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.6);
  transform: scale(1.1);
}

.rating-text {
  text-align: center;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.content-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 16rpx;
}

.image-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-list .image-item,
.image-list .add-image {
  margin: 10rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(233, 69, 96, 0.4);
}

.add-image {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.25);
  transition: all 0.3s ease;
}

.add-image:active {
  transform: scale(0.95);
}

.add-icon {
  font-size: 64rpx;
  color: rgba(255, 255, 255, 0.4);
}

.add-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 12rpx;
}

.submit-section {
  padding: 40rpx 0 60rpx;
}

.submit-btn {
  width: 100%;
  height: 108rpx;
  background: linear-gradient(135deg, #E94560 0%, #c73650 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
  transition: all 0.3s ease;
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}
