page {
  background: #16213E;
}

.checkins-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 头部统计 */
.stats-header {
  padding: 50rpx 30rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #E94560 0%, #c73650 100%);
}

.stats-num {
  font-size: 80rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}

.stats-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.stats-slogan {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
}

/* 时间轴 */
.timeline {
  padding: 30rpx 30rpx 0;
}

.tl-item {
  display: flex;
  align-items: stretch;
}

.tl-node {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E94560;
  box-shadow: 0 0 0 6rpx rgba(233, 69, 96, 0.2);
  margin-top: 30rpx;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.12);
  margin-top: 6rpx;
}

.tl-card {
  flex: 1;
  margin: 0 0 24rpx 20rpx;
  padding: 24rpx;
  background: #1A1A2E;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tl-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-badge {
  font-size: 20rpx;
  color: #FFD166;
  background: rgba(255, 209, 102, 0.12);
  border: 1rpx solid rgba(255, 209, 102, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.tl-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
}

.tl-content {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  line-height: 1.5;
}

.tl-images {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.tl-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #16213E;
}

.tl-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.tl-tag {
  font-size: 22rpx;
  color: #FF8A9B;
  background: rgba(233, 69, 96, 0.12);
  border-radius: 8rpx;
  padding: 2rpx 14rpx;
}

.tl-dist {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 加载/结束 */
.load-more,
.list-end {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  padding: 24rpx 0;
}

/* 空状态 */
.empty {
  padding: 140rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 12rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #E94560, #FF6B6B);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 骨架屏 */
.skeleton-wrap {
  padding: 30rpx;
}

.skeleton-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.skeleton-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  margin-top: 30rpx;
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 16rpx;
}

.skeleton-line.w60 { width: 60%; }
.skeleton-line.w40 { width: 40%; margin-bottom: 0; }
