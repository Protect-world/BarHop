# ===== 服务器配置 =====
NODE_ENV=development
PORT=3000
# 生产环境必须改为 https://你的域名.com（前端图片 URL 会拼接此域名）
SERVER_BASE_URL=http://localhost:3000

# ===== MySQL 配置（与 docker-compose.yml 对应）=====
DB_HOST=localhost
DB_PORT=3307
DB_NAME=barhop
DB_USER=barhop_user
DB_PASSWORD=barhop_pass

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT 密钥 =====
# 生产环境必须用强随机串：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=barhop_jwt_secret

# ===== 微信小程序配置 =====
# 在 mp.weixin.qq.com → 开发管理 → 开发设置 获取
WECHAT_APPID=
WECHAT_SECRET=

# ===== 腾讯地图 LBS Key（酒吧搜索主数据源，必填）=====
# 申请地址：https://lbs.qq.com/dev/console/key/manage
TENCENT_LBS_KEY=

# ===== 高德地图 Key（酒吧图片和评分补充，选填但推荐）=====
# 申请地址：https://console.amap.com/dev/key/app
# 注意：免费版 QPS 限制为 4，代码已实现 250ms 限流
AMAP_KEY=
